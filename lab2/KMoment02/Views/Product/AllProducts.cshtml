@model IEnumerable<KMoment02.Models.Products>

@{
    ViewData["Title"] = "Product";
}


<div class="container-md">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">@ViewData["title"]</h1>
 
    </div>

    <div class="grid-container">
        @foreach (var product in Model)
        {
            <div class="pro-container" data-id="@product.id">
                <div>
                    <img src="@product.imgUrl" alt="@product.name">
                    <h2>@product.name</h2>
                    <p>@product.description</p>
                    <p>@product.price $</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.id" class="btn btn-warning w-auto">Edit</a>

                    <form asp-controller="Product" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@product.id" />
                        <button type="submit" class="btn btn-danger" >Radera</button>
                    </form>
                </div>

            </div>
        }
    </div>
    <div class="d-flex justify-content-between align-items-center my-3 w-50">
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary w-25">Add</a>
    </div>
</div>
