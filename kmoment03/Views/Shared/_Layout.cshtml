<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - kmoment03</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/kmoment03.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
       <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <!-- Brand/Logo -->
        <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
            @* <img src="/images/logo.png" alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2"> *@
            <span class="fw-bold">kmoment03</span>
        </a>

        <!-- Toggler Button for Mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item mx-1">
                    <a class="@(ViewBag.Class == "Books" ? "nav-link text-danger " : "nav-link")" asp-area="" asp-controller="Books" asp-action="Index">
                        Startsida
                    </a>
                </li>
                <li class="nav-item mx-1">
                    <a class="@(ViewBag.Class == "Customer" ? "nav-link text-danger" : "nav-link")" asp-area="" asp-controller="Customers" asp-action="Index">
                        Kunder
                    </a>
                </li>
                <li class="nav-item mx-1">
                    <a class="@(ViewBag.Class == "Author" ? "nav-link text-danger" : "nav-link")" asp-area="" asp-controller="Authors" asp-action="Index">
                        Författare
                    </a>
                </li>
                <li class="nav-item mx-1">
                    <a class="@(ViewBag.Class == "Loan" ? "nav-link text-danger" : "nav-link")" asp-area="" asp-controller="Loans" asp-action="Index">
                        Lån
                    </a>
                </li>
            </ul>

            <!-- Optional: Add a Search Bar or Call-to-Action Button -->
            
        </div>
    </div>
</nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-dark footer text-muted">
        <div class="container text-center text-light">
            &copy; @DateTime.Now.ToString("yyyy") - kmoment03 Mohamed Abokashef
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
