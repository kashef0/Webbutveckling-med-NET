@model IEnumerable<BooksDirectory.Models.Author_data>

@{
    ViewData["Title"] = "Index";
}

<h1>Författare sida</h1>

<p>
    <a asp-action="Create">Skapa nytt</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.About)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.About)
            </td>
            <td>
                <a class="btn btn-warning mb-1" asp-action="Edit" asp-route-id="@item.Id">Uppdatera</a><br /> 
                <a class="btn btn-info mb-1" asp-action="Details" asp-route-id="@item.Id">Detaljer</a> 
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Radera</a>
            </td>
        </tr>
}
    </tbody>
</table>
